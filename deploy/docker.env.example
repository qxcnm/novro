MYSQL_DATABASE=novro
MYSQL_USER=novro_app
MYSQL_PASSWORD=<GENERATE_RANDOM_DATABASE_PASSWORD>
MYSQL_ROOT_PASSWORD=<GENERATE_SEPARATE_RANDOM_ROOT_PASSWORD>
MYSQL_IMAGE=mysql:8.4
NOVRO_IMAGE=novro:offline
NOVRO_DATA_DIR=/data/novro
NOVRO_NGINX_CONF=/data/novro/nginx.conf

# Set this to http://HOST for temporary testing or https://DOMAIN for normal use.
NOVRO_PUBLIC_URL=http://HOST
NOVRO_ALLOWED_ORIGINS=http://HOST
NOVRO_ENVIRONMENT=development
NOVRO_SESSION_SECRET=<GENERATE_AT_LEAST_32_RANDOM_BYTES>
NOVRO_PROVIDER_ENCRYPTION_SECRET=<GENERATE_A_SEPARATE_AT_LEAST_32_BYTE_SECRET>
NOVRO_SESSION_TTL=24h
NOVRO_SESSION_COOKIE_NAME=novro_session
NOVRO_SESSION_COOKIE_SECURE=false
NOVRO_REGISTRATION_ENABLED=true
NOVRO_REFERRAL_REWARD_BPS=1000

# Temporary first-run defaults. Change the password immediately after login.
NOVRO_BOOTSTRAP_USERNAME=novro
NOVRO_BOOTSTRAP_EMAIL=novro@example.invalid
NOVRO_BOOTSTRAP_DISPLAY_NAME=Novro
NOVRO_BOOTSTRAP_PASSWORD=novro123

NOVRO_EMAIL_SMTP_HOST=
NOVRO_EMAIL_SMTP_PORT=587
NOVRO_EMAIL_SMTP_USERNAME=
NOVRO_EMAIL_SMTP_PASSWORD=
NOVRO_EMAIL_SMTP_TLS=true
NOVRO_EMAIL_FROM=

NOVRO_OIDC_ISSUER=
NOVRO_OIDC_CLIENT_ID=
NOVRO_OIDC_CLIENT_SECRET=
NOVRO_OIDC_DISPLAY_NAME=Enterprise account
NOVRO_OIDC_AUTO_REGISTER=true

NOVRO_EPAY_API_URL=
NOVRO_EPAY_MERCHANT_ID=
NOVRO_EPAY_MERCHANT_KEY=
NOVRO_EPAY_SITE_NAME=Novro
NOVRO_EPAY_CHANNELS=alipay,wxpay

NOVRO_HTTP_PORT=80
NOVRO_HTTPS_PORT=443
TZ=Asia/Shanghai
