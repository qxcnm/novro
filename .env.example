NOVRO_ENVIRONMENT=development
NOVRO_HTTP_ADDR=:8080

NOVRO_DATABASE_DRIVER=mysql
NOVRO_DATABASE_HOST=<DATABASE_HOST>
NOVRO_DATABASE_PORT=3306
NOVRO_DATABASE_NAME=novro
NOVRO_DATABASE_USER=novro_app
NOVRO_DATABASE_PASSWORD=<LOCAL_OR_DEPLOYMENT_SECRET>
NOVRO_DATABASE_TLS=true
NOVRO_DATABASE_MAX_OPEN_CONNS=10
NOVRO_DATABASE_MAX_IDLE_CONNS=5
NOVRO_DATABASE_CONN_MAX_LIFETIME=30m

NOVRO_SESSION_SECRET=<GENERATE_AT_LEAST_32_RANDOM_BYTES>
NOVRO_PROVIDER_ENCRYPTION_SECRET=<GENERATE_A_SEPARATE_AT_LEAST_32_BYTE_SECRET>
NOVRO_SESSION_TTL=24h
NOVRO_SESSION_COOKIE_NAME=novro_session
NOVRO_SESSION_COOKIE_SECURE=false
NOVRO_ALLOWED_ORIGINS=http://localhost:3000
NOVRO_PUBLIC_URL=http://localhost:3000
NOVRO_FILING_NUMBER=

# Optional authentication features. Generate the setup token locally and
# remove it from the deployment environment after the first administrator is created.
NOVRO_SETUP_TOKEN=<GENERATE_AT_LEAST_24_RANDOM_BYTES>
NOVRO_REGISTRATION_ENABLED=true

# bootstrap-admin and the Docker deployment use these first-run values.
# Set the password only in an ignored runtime environment file.
NOVRO_BOOTSTRAP_USERNAME=novro
NOVRO_BOOTSTRAP_EMAIL=novro@example.invalid
NOVRO_BOOTSTRAP_DISPLAY_NAME=Novro
NOVRO_BOOTSTRAP_PASSWORD=

# Database-backed referral settings become authoritative after migration 0020.
# This basis-point value is the fallback for an installation without that row.
# 1000 = 10%, 0 disables new cashback credits.
NOVRO_REFERRAL_REWARD_BPS=1000

# Optional bootstrap fallback for registration email verification. The admin
# email settings page becomes authoritative after its first save. In
# development, leave SMTP empty to log generated codes server-side.
NOVRO_EMAIL_SMTP_HOST=
NOVRO_EMAIL_SMTP_PORT=587
NOVRO_EMAIL_SMTP_USERNAME=
NOVRO_EMAIL_SMTP_PASSWORD=
NOVRO_EMAIL_SMTP_TLS=true
NOVRO_EMAIL_FROM=

# Leave every OIDC value empty to disable enterprise sign-in.
NOVRO_OIDC_ISSUER=
NOVRO_OIDC_CLIENT_ID=
NOVRO_OIDC_CLIENT_SECRET=
NOVRO_OIDC_DISPLAY_NAME=企业账号
NOVRO_OIDC_AUTO_REGISTER=true

# Optional bootstrap defaults for the admin payment page. Leave the three
# credential values empty to start with payments disabled; later edits persist
# in the database and become the runtime source of truth.
NOVRO_EPAY_API_URL=
NOVRO_EPAY_MERCHANT_ID=
NOVRO_EPAY_MERCHANT_KEY=
NOVRO_EPAY_SITE_NAME=Novro
NOVRO_EPAY_CHANNELS=alipay,wxpay
