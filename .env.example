NOVRO_ENVIRONMENT=development
NOVRO_HTTP_ADDR=:8080

NOVRO_DATABASE_DRIVER=mysql
NOVRO_DATABASE_HOST=117.72.17.16
NOVRO_DATABASE_PORT=3306
NOVRO_DATABASE_NAME=novro-db
NOVRO_DATABASE_USER=novro_app
NOVRO_DATABASE_PASSWORD=<LOCAL_OR_DEPLOYMENT_SECRET>
NOVRO_DATABASE_TLS=true
NOVRO_DATABASE_MAX_OPEN_CONNS=10
NOVRO_DATABASE_MAX_IDLE_CONNS=5
NOVRO_DATABASE_CONN_MAX_LIFETIME=30m

NOVRO_SESSION_SECRET=<GENERATE_AT_LEAST_32_RANDOM_BYTES>
NOVRO_SESSION_TTL=24h
NOVRO_SESSION_COOKIE_NAME=novro_session
NOVRO_SESSION_COOKIE_SECURE=false
NOVRO_ALLOWED_ORIGINS=http://localhost:3000
NOVRO_PUBLIC_URL=http://localhost:3000

# Optional authentication features. Generate the setup token locally and
# remove it from the deployment environment after the first administrator is created.
NOVRO_SETUP_TOKEN=<GENERATE_AT_LEAST_24_RANDOM_BYTES>
NOVRO_REGISTRATION_ENABLED=true

# Leave every OIDC value empty to disable enterprise sign-in.
NOVRO_OIDC_ISSUER=
NOVRO_OIDC_CLIENT_ID=
NOVRO_OIDC_CLIENT_SECRET=
NOVRO_OIDC_DISPLAY_NAME=企业账号
NOVRO_OIDC_AUTO_REGISTER=true
